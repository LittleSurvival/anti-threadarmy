{
  "name": "anti-threadarmy",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @anti-threadarmy/web dev",
    "dev:web": "pnpm --filter @anti-threadarmy/web dev",
    "dev:extension": "pnpm --filter @anti-threadarmy/extension dev",
    "build": "pnpm --filter @anti-threadarmy/web --filter @anti-threadarmy/extension build",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @anti-threadarmy/extension build && node --test packages/threads-client/tests/*.test.mjs apps/extension/tests/background.test.mjs",
    "test:browser": "node apps/web/tests/browser-smoke.mjs && node apps/extension/tests/browser-smoke.mjs"
  },
  "devDependencies": {
    "@prettier/plugin-xml": "3.4.2",
    "prettier": "3.10.1"
  }
}
